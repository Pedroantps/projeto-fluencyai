PORT=3333
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/fluencyai"
# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGINS="http://localhost:3000"
GEMINI_API_KEY=
GROQ_API_KEY=
# TTS local (Kokoro), sem chave. Vozes: af_heart, af_bella, am_michael...
TTS_VOICE=af_heart
FIREBASE_PROJECT_ID=
# Modelo de chat do Groq
CHAT_MODEL=openai/gpt-oss-120b
