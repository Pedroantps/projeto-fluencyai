PORT=3333
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/fluencyai"
# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGINS="http://localhost:3000"
GEMINI_API_KEY=
GROQ_API_KEY=
# Texto -> fala. auto = Azure se houver chave, senao Kokoro local
TTS_PROVIDER=auto
# Azure AI Speech (Portal > recurso Speech > Chaves e Ponto de Extremidade)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
# Se o Azure falhar, usa o Kokoro local (true/false)
TTS_FALLBACK_KOKORO=true
# TTS local (Kokoro), sem chave. Vozes: af_heart, af_bella, am_michael...
TTS_VOICE=af_heart
FIREBASE_PROJECT_ID=
# Modelo de chat do Groq
CHAT_MODEL=openai/gpt-oss-120b
